{
  "name": "ai-fomo-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Daily bilingual (Hebrew/English) AI news front page for Uriel Mondrowicz",
  "type": "module",
  "scripts": {
    "validate": "node scripts/build.mjs --validate-only",
